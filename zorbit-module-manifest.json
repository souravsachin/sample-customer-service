{
  "manifestVersion": "2.0",
  "moduleId": "sample-customer-service",
  "moduleType": "app",
  "version": "0.2.0",

  "placement": {
    "scaffold": "developer_center",
    "scaffoldSortOrder": 70,
    "capabilityArea": "samples",
    "sortOrder": 10
  },

  "registration": {
    "kafkaTopic": "platform-module-announcements"
  },

  "navigation": {
    "sections": [
      {
        "id": "guide",
        "sortOrder": 0,
        "items": [
          { "id": "intro",        "sortOrder": 1, "feRoute": "/m/sample-customer-service/guide/intro",        "feComponent": "@platform:GuideIntroView" },
          { "id": "presentation", "sortOrder": 2, "feRoute": "/m/sample-customer-service/guide/presentation", "feComponent": "@platform:GuideSlideDeck" },
          { "id": "lifecycle",    "sortOrder": 3, "feRoute": "/m/sample-customer-service/guide/lifecycle",    "feComponent": "@platform:GuideLifecycle" },
          { "id": "videos",       "sortOrder": 4, "feRoute": "/m/sample-customer-service/guide/videos",       "feComponent": "@platform:GuideVideos" },
          { "id": "resources",    "sortOrder": 5, "feRoute": "/m/sample-customer-service/guide/resources",    "feComponent": "@platform:GuideResources" },
          { "id": "pricing",      "sortOrder": 6, "feRoute": "/m/sample-customer-service/guide/pricing",      "feComponent": "@platform:GuidePricing" }
        ]
      },
      {
        "id": "ops",
        "sortOrder": 10,
        "items": [
          {
            "id": "customers",
            "sortOrder": 1,
            "feRoute": "/m/sample-customer-service/ops/customers",
            "feComponent": "zorbit-pfs-datatable:DataTable",
            "feProps":   { "$src": "./manifest-content/pages/customers.json" },
            "privilege": "samples.customer.read"
          }
        ]
      }
    ]
  },

  "guide": {
    "intro":     { "$src": "./manifest-content/guide/intro.md" },
    "slides":    { "decks":     { "$src": "./manifest-content/guide/slides/index.json" } },
    "lifecycle": { "$src": "./manifest-content/guide/lifecycle.json" },
    "videos":    { "playlists": { "$src": "./manifest-content/guide/videos/index.json" } },
    "resources": { "$src": "./manifest-content/guide/resources.json" },
    "pricing":   { "$src": "./manifest-content/guide/pricing.json" }
  },

  "deployments": {
    "show":  false,
    "health":{ "beRoute": "/api/sample/api/v1/G/health" }
  },

  "backend": {
    "baseUrl":   "http://localhost:3010",
    "apiPrefix": "/api/sample/api/v1"
  },

  "events": {
    "publishes":  ["sample.customer.created", "sample.customer.updated"],
    "subscribes": []
  },

  "errors": { "$src": "./manifest-content/errors.json" },

  "dependencies": ["zorbit-cor-identity", "zorbit-cor-event_bus"]
}
